---
const features = [
  {
    icon: "📊",
    title: "Financial Dashboard",
    description: "Real-time visibility into your organization's financial health with intuitive dashboards and reports."
  },
  {
    icon: "📝",
    title: "Simplified Accounting",
    description: "Automate bookkeeping tasks and generate accurate financial statements with minimal effort."
  },
  {
    icon: "💳",
    title: "Nonprofit Cards",
    description: "Issue cards to staff with custom spending limits and real-time transaction tracking."
  },
  {
    icon: "📱",
    title: "Mobile Access",
    description: "Manage your finances on the go with our user-friendly mobile application."
  },
  {
    icon: "🔒",
    title: "Compliance Tools",
    description: "Stay compliant with built-in tools for tax preparation, audit readiness, and regulatory requirements."
  },
  {
    icon: "🔄",
    title: "Integration Ready",
    description: "Seamlessly connect with your existing tools including donation platforms and CRM systems."
  }
];
---

<section id="features" class="features">
  <div class="container">
    <div class="section-header fade-in">
      <h2>Powerful Features for <span class="text-gradient">Nonprofit Success</span></h2>
      <p>Everything you need to manage your organization's finances efficiently and effectively.</p>
    </div>
    
    <div class="features-grid">
      {features.map((feature, index) => (
        <div class="feature-card card fade-in" style={`--delay: ${index * 0.1}s`}>
          <div class="feature-icon">{feature.icon}</div>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    background-color: var(--background);
  }
  
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }
  
  .section-header p {
    font-size: 1.25rem;
    color: var(--text-light);
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .feature-card {
    display: flex;
    flex-direction: column;
    transition-delay: var(--delay, 0s);
  }
  
  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .feature-card h3 {
    margin-bottom: 1rem;
  }
  
  .feature-card p {
    color: var(--text-light);
    margin-bottom: 0;
  }
  
  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
  }
</style>
