---
const plans = [
  {
    name: "Starter",
    price: "$99",
    period: "per month",
    description: "Perfect for small nonprofits with basic financial needs.",
    features: [
      "Financial dashboard",
      "Basic accounting tools",
      "Up to 3 user accounts",
      "Monthly financial reports",
      "Email support"
    ],
    cta: "Get Started",
    popular: false
  },
  {
    name: "Growth",
    price: "$199",
    period: "per month",
    description: "Ideal for growing organizations with expanding financial requirements.",
    features: [
      "Everything in Starter",
      "Advanced reporting",
      "Up to 10 user accounts",
      "Nonprofit cards (up to 5)",
      "Compliance tools",
      "Priority support"
    ],
    cta: "Get Started",
    popular: true
  },
  {
    name: "Enterprise",
    price: "Custom",
    period: "pricing",
    description: "Tailored solutions for large nonprofits with complex financial operations.",
    features: [
      "Everything in Growth",
      "Unlimited user accounts",
      "Unlimited nonprofit cards",
      "Custom integrations",
      "Dedicated account manager",
      "24/7 premium support"
    ],
    cta: "Contact Us",
    popular: false
  }
];
---

<section id="pricing" class="pricing">
  <div class="container">
    <div class="section-header fade-in">
      <h2>Simple, Transparent <span class="text-gradient">Pricing</span></h2>
      <p>Choose the plan that fits your organization's needs and budget.</p>
    </div>
    
    <div class="pricing-grid">
      {plans.map((plan, index) => (
        <div class={`pricing-card card fade-in ${plan.popular ? 'popular' : ''}`} style={`--delay: ${index * 0.1}s`}>
          {plan.popular && <div class="popular-badge">Most Popular</div>}
          <h3>{plan.name}</h3>
          <div class="price">
            <span class="amount">{plan.price}</span>
            <span class="period">{plan.period}</span>
          </div>
          <p class="description">{plan.description}</p>
          <ul class="features-list">
            {plan.features.map(feature => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <a href="#contact" class={`btn ${plan.popular ? 'btn-primary' : 'btn-secondary'}`}>{plan.cta}</a>
        </div>
      ))}
    </div>
    
    <div class="pricing-note fade-in">
      <p>All plans include a 14-day free trial. No credit card required.</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background-color: var(--background);
  }
  
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }
  
  .section-header p {
    font-size: 1.25rem;
    color: var(--text-light);
  }
  
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }
  
  .pricing-card {
    display: flex;
    flex-direction: column;
    position: relative;
    transition-delay: var(--delay, 0s);
    border: 1px solid var(--border);
  }
  
  .pricing-card.popular {
    border: 2px solid var(--primary);
    transform: scale(1.05);
  }
  
  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--primary);
    color: white;
    padding: 0.25rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
  }
  
  .pricing-card h3 {
    margin-bottom: 1rem;
    text-align: center;
  }
  
  .price {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  
  .amount {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-dark);
  }
  
  .period {
    font-size: 1rem;
    color: var(--text-light);
  }
  
  .description {
    text-align: center;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }
  
  .features-list {
    list-style: none;
    margin-bottom: 2rem;
    flex-grow: 1;
  }
  
  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  
  .features-list svg {
    color: var(--primary);
  }
  
  .pricing-card .btn {
    width: 100%;
  }
  
  .pricing-note {
    text-align: center;
    color: var(--text-light);
    font-size: 0.875rem;
  }
  
  @media (max-width: 992px) {
    .pricing-card.popular {
      transform: scale(1);
    }
  }
</style>
