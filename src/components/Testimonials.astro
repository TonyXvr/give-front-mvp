---
const testimonials = [
  {
    quote: "Givefront has transformed how we manage our finances. We've saved countless hours on accounting tasks and have much better visibility into our financial health.",
    author: "Sarah Johnson",
    role: "Executive Director",
    organization: "Community Outreach Foundation"
  },
  {
    quote: "The compliance tools alone are worth the investment. We used to spend weeks preparing for audits, but now we're always audit-ready.",
    author: "Michael Chen",
    role: "Finance Director",
    organization: "Global Education Initiative"
  },
  {
    quote: "As a small nonprofit, we couldn't afford a full-time accountant. Givefront gives us professional-level financial management at a fraction of the cost.",
    author: "Jessica Rodriguez",
    role: "Founder",
    organization: "Helping Hands Charity"
  }
];
---

<section id="testimonials" class="testimonials">
  <div class="container">
    <div class="section-header fade-in">
      <h2>Trusted by <span class="text-gradient">Nonprofits</span> Everywhere</h2>
      <p>Hear what our customers have to say about their experience with Givefront.</p>
    </div>
    
    <div class="testimonials-grid">
      {testimonials.map((testimonial, index) => (
        <div class="testimonial-card card fade-in" style={`--delay: ${index * 0.1}s`}>
          <div class="quote-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
          </div>
          <p class="quote">{testimonial.quote}</p>
          <div class="author">
            <div class="author-info">
              <h4>{testimonial.author}</h4>
              <p>{testimonial.role}, {testimonial.organization}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="logos fade-in">
      <h3>Trusted by organizations like</h3>
      <div class="logos-grid">
        <div class="logo-item">Goodwill</div>
        <div class="logo-item">Forests Foundation</div>
        <div class="logo-item">Clarkston Times</div>
        <div class="logo-item">Empower</div>
        <div class="logo-item">Wildlife Fund</div>
        <div class="logo-item">Boys & Girls Club</div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background-color: var(--background-alt);
  }
  
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }
  
  .section-header p {
    font-size: 1.25rem;
    color: var(--text-light);
  }
  
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  .testimonial-card {
    display: flex;
    flex-direction: column;
    transition-delay: var(--delay, 0s);
  }
  
  .quote-icon {
    color: var(--primary-light);
    opacity: 0.3;
    margin-bottom: 1rem;
  }
  
  .quote {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    flex-grow: 1;
  }
  
  .author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .author-info h4 {
    margin-bottom: 0.25rem;
  }
  
  .author-info p {
    color: var(--text-light);
    font-size: 0.875rem;
    margin-bottom: 0;
  }
  
  .logos {
    text-align: center;
  }
  
  .logos h3 {
    font-size: 1.25rem;
    color: var(--text-light);
    margin-bottom: 2rem;
  }
  
  .logos-grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 3rem;
  }
  
  .logo-item {
    color: var(--text-medium);
    font-weight: 600;
    font-size: 1.25rem;
    opacity: 0.7;
    transition: var(--transition);
  }
  
  .logo-item:hover {
    opacity: 1;
    color: var(--primary);
  }
  
  @media (max-width: 768px) {
    .logos-grid {
      gap: 2rem 1.5rem;
    }
    
    .logo-item {
      font-size: 1rem;
    }
  }
</style>
