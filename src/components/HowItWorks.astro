---
const steps = [
  {
    number: "01",
    title: "Request a Demo",
    description: "Schedule a personalized demo to see how Givefront can help your organization."
  },
  {
    number: "02",
    title: "Onboarding",
    description: "Our team will help you set up your account and import your financial data."
  },
  {
    number: "03",
    title: "Training",
    description: "Get comprehensive training for your team to make the most of the platform."
  },
  {
    number: "04",
    title: "Ongoing Support",
    description: "Enjoy continuous support and regular updates to enhance your experience."
  }
];
---

<section id="how-it-works" class="how-it-works">
  <div class="container">
    <div class="section-header fade-in">
      <h2>How <span class="text-gradient">Givefront</span> Works</h2>
      <p>Getting started is simple. We'll guide you through every step of the process.</p>
    </div>
    
    <div class="steps">
      {steps.map((step, index) => (
        <div class="step fade-in" style={`--delay: ${index * 0.1}s`}>
          <div class="step-number">{step.number}</div>
          <div class="step-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </div>
      ))}
    </div>
    
    <div class="cta-container fade-in">
      <div class="cta-card">
        <div class="cta-content">
          <h3>Ready to transform your nonprofit's financial management?</h3>
          <p>Join hundreds of nonprofits that trust Givefront to manage their finances.</p>
          <a href="#contact" class="btn btn-primary">Get Started Today</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    background-color: var(--background-alt);
    position: relative;
  }
  
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }
  
  .section-header p {
    font-size: 1.25rem;
    color: var(--text-light);
  }
  
  .steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto 4rem;
    position: relative;
  }
  
  .steps::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 2.5rem;
    width: 2px;
    background-color: var(--primary-bg);
    z-index: 1;
  }
  
  .step {
    display: flex;
    gap: 2rem;
    position: relative;
    z-index: 2;
    transition-delay: var(--delay, 0s);
  }
  
  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    background-color: var(--primary-bg);
    color: var(--primary);
    border-radius: 50%;
    font-size: 1.5rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  
  .step-content {
    padding-top: 0.5rem;
  }
  
  .step-content h3 {
    margin-bottom: 0.5rem;
  }
  
  .step-content p {
    color: var(--text-light);
  }
  
  .cta-container {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .cta-card {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    border-radius: var(--radius);
    padding: 3rem;
    color: white;
    text-align: center;
    box-shadow: var(--shadow);
  }
  
  .cta-content h3 {
    color: white;
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }
  
  .cta-content p {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }
  
  .cta-content .btn {
    background-color: white;
    color: var(--primary);
  }
  
  .cta-content .btn:hover {
    background-color: rgba(255, 255, 255, 0.9);
  }
  
  @media (max-width: 768px) {
    .steps::before {
      left: 1.5rem;
    }
    
    .step {
      gap: 1rem;
    }
    
    .step-number {
      width: 3rem;
      height: 3rem;
      font-size: 1rem;
    }
    
    .cta-card {
      padding: 2rem;
    }
  }
</style>
